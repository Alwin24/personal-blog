---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TAGLINE, SOCIALS } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p class="tagline">{TAGLINE}</p>
				<p>
					I build Solana smart contracts in Anchor and Rust: CPI-heavy integrations
					with protocols like Jupiter, Raydium, and Meteora, plus staking systems,
					token launchpads, and NFT programs. Four years of it, 15+ programs on
					mainnet. This is where I write about how that work actually gets done.
				</p>
				<p class="intro-links">
					<a href={SOCIALS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
					<span class="sep">·</span>
					<a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
				</p>
			</section>

			<section class="writing">
				<h2>Writing</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a class="post-link" href={`/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<FormattedDate class="post-date" date={post.data.pubDate} />
								</a>
								{post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
							</li>
						))
					}
				</ul>
				<p class="all-link"><a href="/blog">All posts →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 3.5em;
	}
	.intro h1 {
		margin-bottom: 0.1em;
	}
	.tagline {
		color: var(--text-muted);
		font-size: 1.05rem;
		margin-bottom: 1.25em;
	}
	.intro-links a {
		color: var(--text-muted);
		text-decoration: none;
	}
	.intro-links a:hover {
		color: var(--text-strong);
	}
	.sep {
		color: var(--border);
		margin: 0 0.4em;
	}

	.writing h2 {
		font-size: 1.05rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		font-weight: 600;
		margin-bottom: 1.25em;
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		margin-bottom: 1.6em;
	}
	.post-link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		text-decoration: none;
	}
	.post-title {
		color: var(--text-strong);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}
	.post-link:hover .post-title {
		text-decoration-color: var(--text-strong);
	}
	.post-date {
		color: var(--text-muted);
		font-size: 0.85rem;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.post-desc {
		margin: 0.25em 0 0 0;
		color: var(--text-muted);
		font-size: 0.95rem;
	}
	.all-link {
		margin-top: 2em;
	}
	.all-link a {
		color: var(--text-muted);
		font-size: 0.95rem;
		text-decoration: none;
	}
	.all-link a:hover {
		color: var(--text-strong);
	}
	@media (max-width: 540px) {
		.post-link {
			flex-direction: column;
			gap: 0.15em;
		}
	}
</style>
