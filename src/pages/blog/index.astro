---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();

// Group posts by year, preserving newest-first order.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	if (!byYear.has(year)) byYear.set(year, []);
	byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const pageTitle = 'Writing';
const pageDescription =
	'Technical writing on Solana smart contract development by Alwin Helor.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Writing</h1>
			{
				years.map((year) => (
					<section class="year-group">
						<h2 class="year">{year}</h2>
						<ul class="post-list">
							{byYear.get(year)!.map((post) => (
								<li>
									<a class="post-link" href={`/blog/${post.id}/`}>
										<span class="post-title">{post.data.title}</span>
										<FormattedDate class="post-date" date={post.data.pubDate} />
									</a>
									{post.data.description && (
										<p class="post-desc">{post.data.description}</p>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}
			{posts.length === 0 && <p class="empty">No posts yet. Soon.</p>}
		</main>
		<Footer />
	</body>
</html>

<style>
	main h1 {
		margin-bottom: 1.5em;
	}
	.year-group {
		margin-bottom: 2.5em;
	}
	.year {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-muted);
		letter-spacing: 0.04em;
		padding-bottom: 0.5em;
		margin-bottom: 1.25em;
		border-bottom: 1px solid var(--border);
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		margin-bottom: 1.6em;
	}
	.post-link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		text-decoration: none;
	}
	.post-title {
		color: var(--text-strong);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}
	.post-link:hover .post-title {
		text-decoration-color: var(--text-strong);
	}
	.post-date {
		color: var(--text-muted);
		font-size: 0.85rem;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.post-desc {
		margin: 0.25em 0 0 0;
		color: var(--text-muted);
		font-size: 0.95rem;
	}
	.empty {
		color: var(--text-muted);
	}
	@media (max-width: 540px) {
		.post-link {
			flex-direction: column;
			gap: 0.15em;
		}
	}
</style>
